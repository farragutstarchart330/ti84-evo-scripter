{
  "program": "TRISOLV.py",
  "reference": "Areas cross-checked Heron vs ab*sin(C)/2; angles cross-checked law of cosines vs law of sines; angle sums verified to 180; law-of-sines ratio verified constant across all three side/angle pairs.",
  "cases": [
    {
      "name": "SSS 3-4-5 right triangle",
      "inputs": ["1", "3", "4", "5"],
      "expect": ["a = 3.000  A = 36.870", "b = 4.000  B = 53.130",
                 "c = 5.000  C = 90.000", "Area  = 6.000",
                 "Perim = 12.000"],
      "reject": ["Traceback", "Not a triangle"]
    },
    {
      "name": "SAS a=5 b=7 C=45deg",
      "inputs": ["2", "5", "7", "45"],
      "expect": ["a = 5.000  A = 45.582", "b = 7.000  B = 89.418",
                 "c = 4.950  C = 45.000", "Area  = 12.374",
                 "Perim = 16.950"]
    },
    {
      "name": "ASA A=30 B=60 c=10",
      "inputs": ["3", "30", "60", "10"],
      "expect": ["a = 5.000  A = 30.000", "b = 8.660  B = 60.000",
                 "c = 10.000  C = 90.000", "Area  = 21.651",
                 "Perim = 23.660"]
    },
    {
      "name": "edge: impossible SSS 1-2-10",
      "inputs": ["1", "1", "2", "10"],
      "expect": ["Not a triangle"],
      "reject": ["Area", "Traceback", "math domain error"]
    },
    {
      "name": "edge: ASA angles sum to 180",
      "inputs": ["3", "120", "60", "10"],
      "expect": ["A + B must be < 180"],
      "reject": ["Area", "ZeroDivisionError", "Traceback"]
    },
    {
      "name": "edge: bad mode then zero side re-prompted",
      "inputs": ["9", "1", "0", "3", "4", "5"],
      "expect": ["Pick 1, 2 or 3", "Must be > 0", "Area  = 6.000"],
      "reject": ["Traceback"]
    },
    {
      "name": "edge: degrees really are degrees, not radians",
      "inputs": ["2", "1", "1", "90"],
      "expect": ["c = 1.414", "Area  = 0.500"],
      "reject": ["Traceback"]
    }
  ]
}
